{
  "name": "education-system-backend",
  "version": "1.0.0",
  "description": "Education System Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:nodemon": "nodemon src/server.js",
    "reset:db": "node scripts/resetDatabase.js",
    "reset:db:keep-users": "node scripts/resetDatabase.js --keep-users",
    "seed:users": "node scripts/seedUsers.js",
    "seed:classes": "node scripts/seedClasses.js",
    "seed:posts": "node scripts/seedPosts.js",
    "seed:comments": "node scripts/seedComments.js",
    "seed:messages": "node scripts/seedMessages.js",
    "seed:all": "npm run seed:users && npm run seed:classes && npm run seed:posts && npm run seed:comments && npm run seed:messages",
    "reset:and:seed": "npm run reset:db && npm run seed:all"
  },
  "keywords": [
    "education",
    "api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@arcjet/node": "^1.0.0-beta.13",
    "@clerk/clerk-sdk-node": "^4.13.1",
    "@clerk/express": "^1.7.42",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-validator": "^7.3.0",
    "helmet": "^7.1.0",
    "isomorphic-dompurify": "^2.31.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.2",
    "streamifier": "^0.1.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
